{
  "name": "@trading/aggregator",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "NODE_OPTIONS='--max-old-space-size=4096' tsx watch src/index.ts",
    "start": "tsx src/index.ts",
    "build": "tsc -p .",
    "typecheck": "tsc --noEmit",
    "score": "tsx scripts/score_outcomes.ts",
    "score:report": "tsx scripts/score_report.ts",
    "score:report:a": "tsx scripts/score_report.ts --strategy A",
    "score:report:b": "tsx scripts/score_report.ts --strategy B",
    "compare": "tsx scripts/compare_strategies.ts",
    "backfill:clean": "tsx scripts/backfill_clean.ts",
    "backfill:absorption": "tsx scripts/backfill_absorption.ts",
    "backfill:conviction": "tsx scripts/backfill_conviction.ts",
    "backfill:strategy-d": "tsx scripts/backfill_strategy_d.ts",
    "backfill:strategy-i": "tsx scripts/backfill_strategy_i.ts",
    "migrate:strategy-version": "tsx scripts/migrate_strategy_version.ts",
    "levels:add": "tsx scripts/levels_cli.ts",
    "levels:structural": "tsx scripts/compute_structural_levels.ts",
    "levels:structural:evening": "tsx scripts/compute_structural_levels.ts --evening",
    "context:set": "tsx scripts/context_set.ts set",
    "context:show": "tsx scripts/context_set.ts show",
    "context:bbb": "tsx scripts/context_set.ts bbb",
    "context:res": "tsx scripts/context_set.ts res",
    "context:resilience": "tsx scripts/context_set.ts res",
    "qualify": "tsx scripts/reapply_quality_gates.ts",
    "shadow": "tsx scripts/rs-shadow.ts",
    "shadow:resolve": "tsx scripts/rs-shadow-resolve.ts",
    "l3:worker": "tsx scripts/l3-book-worker.ts",
    "l3:decider": "tsx scripts/l3-decision-worker.ts",
    "l3:smoke": "tsx scripts/l3-book-smoke.ts",
    "heatmap:worker": "tsx watch scripts/heatmap-worker.ts",
    "flow:worker": "tsx watch scripts/flow-worker.ts",
    "tape:worker": "tsx watch scripts/tape-worker.ts",
    "tape:test": "tsx scripts/tape_unit_tests.ts",
    "tape:label": "tsx scripts/label_tape_outcomes.ts",
    "tape:calibrate": "NODE_OPTIONS=--max-old-space-size=24576 tsx scripts/calibrate_tape.ts",
    "drift:worker": "tsx watch scripts/drift-worker.ts"
  },
  "dependencies": {
    "@duckdb/node-api": "1.5.3-r.3",
    "@fastify/static": "^7.0.4",
    "@fastify/websocket": "^10.0.1",
    "@trading/contracts": "workspace:*",
    "better-sqlite3": "^11.0.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.27.0",
    "pino": "^9.1.0",
    "pino-pretty": "^11.1.0",
    "ws": "^8.17.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.10",
    "@types/node": "^20.12.12",
    "@types/ws": "^8.5.10",
    "ts-node": "^10.9.2",
    "tsx": "^4.11.0",
    "typescript": "^5.4.5"
  }
}
