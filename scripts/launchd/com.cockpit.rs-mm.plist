<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cockpit.rs-mm</string>

  <!-- MM-only refresh every ~30 min. The wrapper RTH-gates (Mon-Fri 09:30-16:00 ET)
       and no-ops outside it. Re-reads mmBullish + LM into rs-context so the auto
       greater-market tracks intraday price moving into/out of zones. The once-daily
       zones/DD/HP/MHP read stays in com.cockpit.rs-levels (09:32). -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/ravikumarbasker/trading-cockpit/scripts/launchd/rs-mm.sh</string>
  </array>

  <key>StartInterval</key>
  <integer>1800</integer>

  <key>RunAtLoad</key>
  <true/>

  <key>StandardOutPath</key>
  <string>/Users/ravikumarbasker/Library/Logs/cockpit-rs-mm.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ravikumarbasker/Library/Logs/cockpit-rs-mm.log</string>
</dict>
</plist>
