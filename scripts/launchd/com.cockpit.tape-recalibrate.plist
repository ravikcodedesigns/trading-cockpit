<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cockpit.tape-recalibrate</string>

  <!-- Nightly full-parquet detector recalibration → data/tape-calibration.json (22:30 ET).
       Live engine hot-reloads the file; no restart. See scripts/launchd/tape-recalibrate.sh. -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/ravikumarbasker/trading-cockpit/scripts/launchd/tape-recalibrate.sh</string>
  </array>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Hour</key><integer>22</integer>
    <key>Minute</key><integer>30</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/ravikumarbasker/Library/Logs/cockpit-tape-recalibrate.stdout.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ravikumarbasker/Library/Logs/cockpit-tape-recalibrate.stderr.log</string>
</dict>
</plist>
