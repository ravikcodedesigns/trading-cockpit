<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.cockpit.rs-shadow</string>

  <!-- rs-shadow: EST shadow harness. Each RTH tick builds the MarketState from
       rs-context + daily_levels + the live futures price, runs the EST engine,
       and logs NEW setups to data/rs-shadow.db. Shadow only — NO orders. Outcome
       resolution is a separate post-close step (pnpm shadow:resolve). -->
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>/Users/ravikumarbasker/trading-cockpit/scripts/launchd/rs-shadow.sh</string>
  </array>

  <key>EnvironmentVariables</key>
  <dict>
    <key>INTERVAL</key><string>15</string>
  </dict>

  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>30</integer>

  <key>StandardOutPath</key>
  <string>/Users/ravikumarbasker/Library/Logs/cockpit-rs-shadow.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/ravikumarbasker/Library/Logs/cockpit-rs-shadow.log</string>
</dict>
</plist>
